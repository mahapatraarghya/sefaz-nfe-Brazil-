# Copy to .env (never commit it) and load it in your shell: set -a; . ./.env; set +a
NFE_AMBIENTE=homologacao            # homologacao | producao
NFE_CERT_PATH=/caminho/seguro/ecnpj.pfx
NFE_CERT_PASSWORD=                  # senha do certificado A1
NFE_CA_BUNDLE=/caminho/icp-brasil-chain.pem   # cadeia ICP-Brasil para validar o servidor da SEFAZ
NFE_EMITENTE=emitente.json
NFE_DATA_DIR=data
NFE_SERIE=1
# NFE_XSD_DIR=schemas/PL_009_V4     # opcional: pasta com nfe_v4.00.xsd para validação local
